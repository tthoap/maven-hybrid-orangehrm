<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI automation Testing" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
<!--        <listener class-name="reportConfig.ChainTestReport"></listener>-->
        <listener class-name="reportConfig.AllureTestListener"></listener>
<!--        <listener class-name="jiraConfigs.JiraListener"></listener>-->
    </listeners>
    
<!--    <parameter name="appUrl" value="http://localhost:90/orangehrm-5.7"></parameter>-->
<!--    <parameter name="server" value="live"></parameter>-->
    <parameter name="environment" value="live"></parameter>

    <test name="Run on Chrome browser" >
        <parameter name="osName" value="windows"></parameter>
        <parameter name="osVersion" value="10"></parameter>
        <parameter name="browserName" value="Chrome"></parameter>
        <parameter name="browserVersion" value="latest"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_BrowserStack" />
        </classes>
    </test>

    <test name="Run on Firefox browser" >
        <parameter name="osName" value="windows"></parameter>
        <parameter name="osVersion" value="11"></parameter>
        <parameter name="browserName" value="firefox"></parameter>
        <parameter name="browserVersion" value="latest"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_BrowserStack" />
        </classes>
    </test>

    <test name="Run on Safari browser" >
        <parameter name="osName" value="OS X"></parameter>
        <parameter name="osVersion" value="Ventura"></parameter>
        <parameter name="browserName" value="Safari"></parameter>
        <parameter name="browserVersion" value="16.5"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_BrowserStack" />
        </classes>
    </test>



   </suite>