<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI automation Testing" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
<!--        <listener class-name="reportConfig.ChainTestReport"></listener>-->
        <listener class-name="reportConfig.AllureTestListener"></listener>
<!--        <listener class-name="jiraConfigs.JiraListener"></listener>-->
    </listeners>
    
<!--    <parameter name="appUrl" value="http://localhost:90/orangehrm-5.7"></parameter>-->
<!--    <parameter name="server" value="live"></parameter>-->
    <parameter name="environment" value="live"></parameter>

    <test name="Run on Chrome browser" >
        <parameter name="browser" value="chrome"></parameter>
        <parameter name="osName" value="windows"></parameter>
        <parameter name="ipAddress" value="192.168.1.143"></parameter> <!-- HUB's address-->
        <parameter name="port" value="4444"></parameter>  <!-- HUB's port-->
        <classes>
            <class name="com.orangehrm.Level_27_GRID" />
        </classes>
    </test>

    <test name="Run on Edge browser" >
        <parameter name="browser" value="edge"></parameter>
        <parameter name="osName" value="windows"></parameter>
        <parameter name="ipAddress" value="192.168.1.143"></parameter> <!-- HUB's address-->
        <parameter name="port" value="4444"></parameter>  <!-- HUB's port-->
        <classes>
            <class name="com.orangehrm.Level_27_GRID" />
        </classes>
    </test>

    <test name="Run on Firefox browser" >
        <parameter name="browser" value="firefox"></parameter>
        <parameter name="osName" value="windows"></parameter>
        <parameter name="ipAddress" value="192.168.1.143"></parameter> <!-- HUB's address-->
        <parameter name="port" value="4444"></parameter>  <!-- HUB's port-->
        <classes>
            <class name="com.orangehrm.Level_27_GRID" />
        </classes>
    </test>

   </suite>