<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI automation Testing" parallel="tests" thread-count="2" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
<!--        <listener class-name="reportConfig.ChainTestReport"></listener>-->
        <listener class-name="reportConfig.AllureTestListener"></listener>
<!--        <listener class-name="jiraConfigs.JiraListener"></listener>-->
    </listeners>
    
<!--    <parameter name="appUrl" value="http://localhost:90/orangehrm-5.7"></parameter>-->
<!--    <parameter name="server" value="live"></parameter>-->
    <parameter name="environment" value="live"></parameter>

    <test name="Run on Chrome" >
        <parameter name="platformName" value="Windows 11"></parameter>
        <parameter name="browserName" value="Chrome"></parameter>
        <parameter name="browserVersion" value="latest"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_SauceLabs" />
        </classes>
    </test>

    <test name="Run on Edge" >
        <parameter name="platformName" value="Windows 10"></parameter>
        <parameter name="browserName" value="Edge"></parameter>
        <parameter name="browserVersion" value="latest"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_SauceLabs" />
        </classes>
    </test>

    <test name="Run on Firefox" >
        <parameter name="platformName" value="Linux"></parameter>
        <parameter name="browserName" value="Firefox"></parameter>
        <parameter name="browserVersion" value="latest"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_SauceLabs" />
        </classes>
    </test>

    <test name="Run on Safari" >
        <parameter name="platformName" value="macOS 26"></parameter>
        <parameter name="browserName" value="Safari"></parameter>
        <parameter name="browserVersion" value="26"></parameter>
        <classes>
            <class name="com.orangehrm.Level_28_Cloud_SauceLabs" />
        </classes>
    </test>



</suite>