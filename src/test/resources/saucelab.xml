<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM - UI automation Testing" verbose="1" >
    <listeners>
        <listener class-name="core.MethodListener"></listener>
    </listeners>
    
    <parameter name="appUrl" value="https://www.saucedemo.com/"></parameter>
    
    <test name="Run on Chrome browser" >
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="com.saucelab.Level_24_Sortable" />
        </classes>
    </test>

</suite>